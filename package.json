{
  "name": "recall-watchdog",
  "version": "1.0.0",
  "private": true,
  "description": "A watchdog for Sui wallet activity that learns from owner feedback with Walrus Memory and Tatum Sui RPC.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/check.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && node --test test/*.test.mjs",
    "demo": "npm run build --silent && node dist/demo.js",
    "start": "node dist/server.js",
    "setup-account": "npm run build --silent && node dist/setup-account.js",
    "live": "npm run build --silent && node dist/live.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.7",
    "@mysten-incubation/memwal": "0.1.12",
    "@mysten/seal": "1.5.2",
    "@mysten/sui": "2.38.0",
    "@mysten/walrus": "1.2.37",
    "@protobuf-ts/grpc-transport": "2.11.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.9.2",
    "typescript": "5.9.3"
  }
}
