# Copy names only. Never commit real values. Put real values in your shell or in .env (git ignored).
# Network: testnet (default) or mainnet. Mainnet needs ALLOW_MAINNET=1 and mainnet keys.
NETWORK=
ALLOW_MAINNET=
# Tatum API key (x-api-key). Read from env or from TATUM_API_KEY_FILE (mode 600 file, one line).
TATUM_API_KEY=
TATUM_API_KEY_FILE=
# Sui address to watch (0x + 64 hex). Demo mode does not need it.
WATCH_ADDRESS=
# Walrus Memory delegate private key (hex) and account object id. Read from env or MEMWAL_KEY_FILE.
MEMWAL_KEY=
MEMWAL_KEY_FILE=
MEMWAL_ACCOUNT_ID=
MEMWAL_ACCOUNT_ID_FILE=
MEMWAL_NAMESPACE=
MEMWAL_SERVER_URL=
# Owner wallet key for setup-account only (suiprivkey1...). Read from env or file. Testnet demo wallet only.
SUI_PRIVATE_KEY=
SUI_PRIVATE_KEY_FILE=
# Where setup-account writes the new delegate key (mode 600). Keep outside the repo.
MEMWAL_DELEGATE_KEY_OUT=
# Web server port (default 4173). Binds to 127.0.0.1 only.
PORT=
